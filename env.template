# Frontend Environment Configuration Template
# Copy this file to frontend/.env.production and fill in your values

# Backend API URL - Replace with your deployed backend URL
REACT_APP_API_URL=https://your-backend-url.railway.app

# Environment
REACT_APP_ENVIRONMENT=production

# Optional: Analytics or other service keys
# REACT_APP_GOOGLE_ANALYTICS_ID=your-ga-id
# REACT_APP_SENTRY_DSN=your-sentry-dsn

# Build optimization
GENERATE_SOURCEMAP=false
INLINE_RUNTIME_CHUNK=false
